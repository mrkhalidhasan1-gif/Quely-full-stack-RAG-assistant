{
  "rewrites": [
    {
      "source": "/api/rag/:path*",
      "destination": "/api/rag.py"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/chats/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/style.css",
      "destination": "/frontend/style.css"
    },
    {
      "source": "/script.js",
      "destination": "/frontend/script.js"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    }
  ]
}